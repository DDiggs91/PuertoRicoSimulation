<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.PRS</groupId>
    <artifactId>puerto-rico-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <modules>
        <module>puerto-rico-model</module>
        <module>puerto-rico-session</module>
        <module>puerto-rico-ai</module>
        <module>puerto-rico-lobby</module>
        <module>puerto-rico-contract</module>
        <module>puerto-rico-web</module>
        <module>puerto-rico-frontend</module>
    </modules>
    <properties>
        <lombok.version>1.18.46</lombok.version>
        <testng.version>7.12.0</testng.version>
        <fmt.plugin.version>2.29</fmt.plugin.version>
        <mvn.compiler.plugin.version>3.13.0</mvn.compiler.plugin.version>
        <mvn.surefire.plugin.version>3.5.6</mvn.surefire.plugin.version>
        <google.java.format.version>1.27.0</google.java.format.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <openapi.generator.plugin.version>7.24.0</openapi.generator.plugin.version>
        <jackson.databind.nullable.version>0.2.11</jackson.databind.nullable.version>
        <frontend.maven.plugin.version>2.0.2</frontend.maven.plugin.version>
        <node.version>v22.22.0</node.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- Not managed by the Spring Boot BOM, so pin it here. -->
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>${testng.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Supplies org.openapitools.jackson.nullable.JsonNullable, which the openapi
                 generator's "spring" generator emits for every nullable field. Not managed by
                 the Spring Boot BOM. -->
            <dependency>
                <groupId>org.openapitools</groupId>
                <artifactId>jackson-databind-nullable</artifactId>
                <version>${jackson.databind.nullable.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-lobby</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.PRS</groupId>
                <artifactId>puerto-rico-frontend</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- Compile-time only: the annotations must be importable, but Lombok
             erases itself and is not needed at runtime. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- spring-boot-starter-web is deliberately NOT here: inheriting it put Spring MVC and
             Tomcat on the compile classpath of every module, including the pure-domain ones whose
             READMEs promise no knowledge of the web layer. Modules that need it — puerto-rico-web,
             and puerto-rico-contract for the interfaces it generates — declare it themselves, as
             does the one module that only wanted slf4j out of it. -->
        <!-- Test scope, so it reaches no jar. This is what supplies AssertJ, Mockito and JUnit 5
             everywhere, which every module's tests use. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <!-- Importing spring-boot-dependencies brings dependencyManagement
                     only, so surefire would otherwise fall back to Maven's default. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${mvn.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${mvn.compiler.plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <!-- Keeps parameter names in the compiled bytecode. Spring MVC can resolve an
                         unnamed @PathVariable/@RequestParam from this via reflection instead of
                         requiring an explicit ("name") on every one; without it, only
                         explicitly-named annotations work, which is easy to forget on
                         hand-written controller methods (the generated ones in
                         puerto-rico-contract are never affected — they always emit the explicit
                         name). -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>format</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.google.googlejavaformat</groupId>
                        <artifactId>google-java-format</artifactId>
                        <version>${google.java.format.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>