<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.PRS</groupId>
        <artifactId>puerto-rico-parent</artifactId>
        <version>0.0.1</version>
    </parent>
    <groupId>com.PRS</groupId>
    <artifactId>puerto-rico-web</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.PRS</groupId>
            <artifactId>puerto-rico-lobby</artifactId>
        </dependency>
        <dependency>
            <groupId>com.PRS</groupId>
            <artifactId>puerto-rico-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.PRS</groupId>
            <artifactId>puerto-rico-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.PRS</groupId>
            <artifactId>puerto-rico-frontend</artifactId>
        </dependency>
        <!-- The one module that is a web application. Declared here rather than inherited by every
             module, which used to put Spring MVC and Tomcat on the pure-domain modules' classpath
             (and in their jars) too. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- The generated controller interfaces use @Valid @RequestBody throughout; without a
             provider on the classpath, bean validation silently no-ops instead of rejecting
             malformed requests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Boot 4 split MockMvc test support out of spring-boot-starter-test into its
             own per-web-technology starter; only this module does MVC testing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackages the jar into an executable Spring Boot artifact: what
                 `spring-boot:run` and Playwright's `java -jar` both need. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
