<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.PRS</groupId>
        <artifactId>puerto-rico-parent</artifactId>
        <version>0.0.1</version>
    </parent>
    <groupId>com.PRS</groupId>
    <artifactId>puerto-rico-contract</artifactId>

    <dependencies>
        <!-- Both pulled in by the classes openapi-generator emits below; declared here
             (rather than left to spring-boot-starter-web) so puerto-rico-web gets them
             transitively along with the generated interfaces that need them. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the Java side of the wire contract from the OpenAPI spec below:
                 request/response model records plus a Spring @RequestMapping interface per
                 tag. puerto-rico-web's controllers implement those interfaces, so editing the
                 spec without updating a controller is a compile error, not a test failure
                 discovered later. puerto-rico-frontend generates its TypeScript from the same
                 file (see puerto-rico-frontend's build) — this file is the one source of truth
                 for the wire shape, hand-written on neither side. -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi.generator.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/puerto-rico.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>com.PRS.contract.api</apiPackage>
                            <modelPackage>com.PRS.contract.model</modelPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useTags>true</useTags>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <documentationProvider>none</documentationProvider>
                                <sourceFolder>.</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
